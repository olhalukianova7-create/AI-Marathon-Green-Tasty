# Copy to .env. Use your deployed application; never commit .env.
AQA_UI_BASE_URL=
# Include the API Gateway stage, such as /develop. Do not append /dishes.
AQA_API_BASE_URL=
AQA_HEADLESS=true

# Dedicated Level 1 test accounts. Register all three in the application first;
# the waiter account also needs promotion and location assignment.
AQA_OWNER_EMAIL=
AQA_OWNER_PASSWORD=
AQA_OTHER_CUSTOMER_EMAIL=
AQA_OTHER_CUSTOMER_PASSWORD=
AQA_WAITER_EMAIL=
AQA_WAITER_PASSWORD=
